# Optional. The app works without an AI key and falls back to deterministic explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Use a long random value in production. The app generates a development-only secret when absent.
APP_SECRET=
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
NODE_ENV=development

# Optional managed PostgreSQL. Keep real connection strings out of git.
DATABASE_URL=
DB_POOL_SIZE=10
